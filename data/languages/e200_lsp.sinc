	local resh:4 = 0;
	local resl:4 = 0;
	local sum1:8 = zext(D) - zext(A);
	local above2:1 = sum1 s> 0xffffffff;
	local below3:1 = sum1 s< 0x0;
	resh = sum1:4;
	if (!above2) goto <in_range4>;
	resh = 0xffffffff;
<in_range4>
	if (!below3) goto <in_range5>;
	resh = 0;
<in_range5>
	local sum6:8 = zext(Dodd) - zext(B);
	local above7:1 = sum6 s> 0xffffffff;
	local below8:1 = sum6 s< 0x0;
	resl = sum6:4;
	if (!above7) goto <in_range9>;
	resl = 0xffffffff;
<in_range9>
	if (!below8) goto <in_range10>;
	resl = 0;
<in_range10>
	D = resh;
	Dodd = resl;
	local ov:1 = above2 || below3 || above7 || below8;
	local ovbits:4 = zext(ov) * 0xc000;
	spr200 = (spr200 & 0xffffbfff) | ovbits;
}

