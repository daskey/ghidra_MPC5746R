:zmwguiaas D,A,B	is OP=4 & D & A & B & L2=0 & Dodd & XOP_0_10=0x563
{
	local prod:8 = zext(A) * zext(B);
	local acc:8 = (zext(D) << 32) | zext(Dodd);
	local res:8 = acc + prod;
	local ovf:1 = carry(acc, prod);
	if (!ovf) goto <no_overflow1>;
	res = 0xffffffffffffffff;
<no_overflow1>
	D = res(4);
	Dodd = res:4;
	local ov:1 = ovf;
	local ovbits:4 = zext(ov) * 0xc000;
	spr200 = (spr200 & 0xffffbfff) | ovbits;
}

