# Base + scaled immediate (1.4.1.1)
lspDisp2: disp^"("^RA_OR_ZERO^")" is RA_OR_ZERO & EVUIMM [ disp = EVUIMM * 2; ] { local ea:4 = RA_OR_ZERO + disp; export ea; }
lspDisp4: disp^"("^RA_OR_ZERO^")" is RA_OR_ZERO & EVUIMM [ disp = EVUIMM * 4; ] { local ea:4 = RA_OR_ZERO + disp; export ea; }
